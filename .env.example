# Agile-HQ-PQC Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# Server configuration
HOST=127.0.0.1
PORT=5000

# Authentication & RBAC (HS256 secret for signing session JWT tokens)
# In production, generate a secure 256-bit random key: openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-change-me-xxxxxxxxxxxxxxxx

# Demo account credentials (override for production / testing)
ADMIN_PW=admin@pqc
AUDITOR_PW=audit@pqc
RESEARCHER_PW=research@pqc
OPERATOR_PW=operator@pqc

# Tamper-evident audit log storage and HMAC integrity key
AUDIT_PATH=data/audit.jsonl
AUDIT_HMAC_KEY=dev-audit-key-change-me
